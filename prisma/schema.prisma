generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("STAFF") // ADMIN | STAFF | CLINIC
  clinicId  String?
  clinic    Clinic?  @relation(fields: [clinicId], references: [id])
  orders    Order[]  @relation("ProcessedBy")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Clinic {
  id           String         @id @default(cuid())
  name         String
  nit          String?
  address      String?
  phone        String?
  email        String?
  contactName  String? // persona de contacto (registro desde el Portal Vet)
  neighborhood String? // barrio
  city         String?
  noCharge     Boolean        @default(false) // cliente sin cobro (Pets & Pets): sus resultados nunca se retienen por pago
  users        User[]
  orders       Order[]
  branches     ClinicBranch[]
  customExams  ExamTemplate[] @relation("CustomExamClients") // exámenes personalizados para esta clínica
  createdAt    DateTime       @default(now())
}

// Sede de una clínica (misma cuenta/NIT, distinta dirección). Cada orden puede ir a una sede.
model ClinicBranch {
  id           String   @id @default(cuid())
  clinicId     String
  clinic       Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name         String // ej. "Principal", "Sede Norte"
  address      String
  neighborhood String?
  city         String?
  phone        String?
  orders       Order[]
  createdAt    DateTime @default(now())
}

model Order {
  id             String        @id @default(cuid())
  orderNumber    String        @unique
  patientName    String
  species        String // Canino | Felino | Otro
  breed          String?
  age            String?
  sex            String? // M | H | ND
  ownerName      String?
  clinicId       String?
  clinic         Clinic?       @relation(fields: [clinicId], references: [id])
  branchId       String?
  branch         ClinicBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  requestingVet  String?
  processedById  String?
  processedBy    User?         @relation("ProcessedBy", fields: [processedById], references: [id])
  status         String        @default("RECIBIDA") // SOLICITADA (desde el portal, aún sin recibir) | RECIBIDA | EN_PROCESO | COMPLETADA
  source         String        @default("LAB") // LAB (registrada por el staff) | PORTAL (solicitada por la clínica)
  // Facturación (/facturacion): la contadora marca la orden como facturada con su número de factura
  invoiceNumber  String?
  invoicedAt     DateTime?
  invoicedByName String?
  notes          String?
  exams          OrderExam[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model OrderExam {
  id              String              @id @default(cuid())
  orderId         String
  order           Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  templateId      String
  template        ExamTemplate        @relation(fields: [templateId], references: [id])
  status          String              @default("PENDIENTE") // PENDIENTE | COMPLETADO
  price           Float               @default(0)
  discountType    String              @default("VALOR") // VALOR | PORCENTAJE
  discountValue   Float               @default(0)
  paymentTerm     String              @default("CONTADO") // CONTADO | CREDITO
  paymentMethod   String              @default("EFECTIVO") // EFECTIVO | TRANSFERENCIA
  amountPaid      Float               @default(0)
  results         ExamResult[]
  movements       InventoryMovement[]
  uploadedPdfPath String?
  uploadedPdfName String?
  comments        String? // comentarios del encargado; salen al final del examen en el PDF
  photos          ExamPhoto[]
  // Resultado de bloques con formulario propio (hoy el Coprológico: lib/coprologico.ts), en JSON
  structured      Json?
  completedAt     DateTime?
  createdAt       DateTime            @default(now())
}

// Foto adjunta a un examen de una orden (blob privado; se sirve por /api/photos/[photoId])
model ExamPhoto {
  id          String    @id @default(cuid())
  orderExamId String
  orderExam   OrderExam @relation(fields: [orderExamId], references: [id], onDelete: Cascade)
  url         String
  name        String
  role        String? // null = foto de "Comentarios y fotos"; "COPRO_MACRO" = foto de la muestra del Coprológico
  createdAt   DateTime  @default(now())
}

model ExamTemplate {
  id              String               @id @default(cuid())
  name            String
  area            String // Hematología | Bioquímica | Citología | Uroanálisis | Coprología
  turnaround      String // "Mismo día" | "24h" | "48h"
  sampleType      String
  price           Float? // precio de lista; si existe, se precarga en Caja al crear la orden
  description     String? // qué incluye (perfiles) — se muestra al elegir exámenes
  isPromotion     Boolean              @default(false) // examen combinado creado en /promociones (o personalizado)
  isCustom        Boolean              @default(false) // examen personalizado (/personalizados): solo lo ven los clientes de `clients`
  clients         Clinic[]             @relation("CustomExamClients")
  active          Boolean              @default(true) // false = retirado: no se ofrece en órdenes nuevas
  sections        ExamSection[]
  orderExams      OrderExam[]
  recipeItems     RecipeItem[]
  promoComponents PromotionComponent[] @relation("PromoOf") // si es promoción: exámenes que la componen
  inPromotions    PromotionComponent[] @relation("ComponentOf") // promociones que incluyen este examen
}

// Exámenes que componen una promoción (la promoción es a su vez un ExamTemplate con copia de
// sus secciones/campos/receta; esto solo registra de dónde salió)
model PromotionComponent {
  id          String       @id @default(cuid())
  promotionId String
  promotion   ExamTemplate @relation("PromoOf", fields: [promotionId], references: [id], onDelete: Cascade)
  templateId  String
  template    ExamTemplate @relation("ComponentOf", fields: [templateId], references: [id], onDelete: Cascade)
  order       Int          @default(0)

  @@unique([promotionId, templateId])
}

model ExamSection {
  id         String       @id @default(cuid())
  templateId String
  template   ExamTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String
  order      Int          @default(0)
  fields     ExamField[]
}

model ExamField {
  id            String       @id @default(cuid())
  sectionId     String
  section       ExamSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  name          String
  key           String? // id estable del parámetro en el catálogo (ej. "hematocrito"); usado para resolver calcFormula
  unit          String?
  refCanine     String?
  refFeline     String?
  technique     String?
  fieldType     String       @default("number") // number | text | select | calculated
  calcFormula   String? // expresión con los `key` de otros campos de la misma sección, ej. "proteinas_totales - albumina"
  order         Int          @default(0)
  results       ExamResult[]
  // Copia de un parámetro de un examen maestro (en un perfil, promoción o examen derivado): sus
  // rangos se editan en el maestro (/rangos) y se propagan a todas las copias.
  sourceFieldId String?
  sourceField   ExamField?   @relation("FieldCopies", fields: [sourceFieldId], references: [id], onDelete: SetNull)
  copies        ExamField[]  @relation("FieldCopies")
}

model ExamResult {
  id          String    @id @default(cuid())
  orderExamId String
  orderExam   OrderExam @relation(fields: [orderExamId], references: [id], onDelete: Cascade)
  fieldId     String
  field       ExamField @relation(fields: [fieldId], references: [id])
  value       String
  flagged     Boolean   @default(false) // out of reference range
  createdAt   DateTime  @default(now())
}

model InventoryItem {
  id          String              @id @default(cuid())
  name        String
  unit        String // presentación: ML | GR | MG | UNIDAD | CC | KG | ... (texto libre)
  stock       Float               @default(0)
  minStock    Float?
  // Reactivos (ej. tirillas de orina): marca, lote y vencimiento salen en el control de calidad del reporte
  brand       String?
  lot         String?
  expiresAt   DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  recipeItems RecipeItem[]
  movements   InventoryMovement[]
}

// Receta: cantidad de cada insumo que consume un examen al completarse
model RecipeItem {
  id         String        @id @default(cuid())
  templateId String
  template   ExamTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  itemId     String
  item       InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity   Float

  @@unique([templateId, itemId])
}

model InventoryMovement {
  id          String        @id @default(cuid())
  itemId      String
  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity    Float // negativo = salida, positivo = entrada/ajuste
  reason      String // CONSUMO_EXAMEN | AJUSTE
  orderExamId String?
  orderExam   OrderExam?    @relation(fields: [orderExamId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
}

// Configuración del laboratorio editable desde la app (clave -> JSON). Ej. "orina": valores de
// referencia por especie y cortes del UPC del Parcial de Orina (lib/orina.ts).
model LabSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Registro de muestras eliminadas (solo ADMIN, con motivo obligatorio): la orden se borra pero queda
// quién, cuándo, por qué y una copia de sus datos y resultados (snapshot).
model DeletedOrder {
  id            String   @id @default(cuid())
  orderNumber   String
  patientName   String
  species       String
  ownerName     String?
  clinicName    String?
  branchName    String?
  exams         String // nombres de los exámenes
  total         Float    @default(0) // precio neto total
  paid          Float    @default(0)
  status        String // estado de la orden al borrarla
  orderedAt     DateTime // fecha de creación de la orden
  reason        String
  deletedById   String?
  deletedByName String
  deletedAt     DateTime @default(now())
  snapshot      Json // orden completa con exámenes y resultados
}
