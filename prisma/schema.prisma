generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("STAFF") // ADMIN | STAFF | CLINIC
  clinicId  String?
  clinic    Clinic?  @relation(fields: [clinicId], references: [id])
  orders    Order[]  @relation("ProcessedBy")
  visits    RouteVisit[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// "Día a día" del mensajero (/dia-a-dia, lib/routeDay.ts): una fila por parada atendida en su vuelta, y una con
// result = "LAB" al entregar en el laboratorio (cierra la vuelta). `unscheduled` = paquete NO agendado (la clínica no
// había pedido recogida): da el beneficio por paquete al mensajero.
model RouteVisit {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day         String // AAAA-MM-DD, hora de Colombia
  vuelta      Int
  color       String // Rojo | Azul | Morado | Verde (lib/messengerRoutes.ts: MENSAJEROS)
  clinicId    String?
  branchId    String?
  name        String // nombre de la parada cuando se visitó
  result      String // MUESTRAS | SIN_MUESTRAS | ESPERA | PEDIDO | NO_LISTA | LAB
  unscheduled Boolean  @default(false)
  orderIds    String[]
  createdAt   DateTime @default(now())

  @@index([day, userId])
}

model Clinic {
  id             String           @id @default(cuid())
  name           String
  nit            String?
  address        String?
  phone          String?
  email          String?
  billingEmail   String? // correo de facturación (Siigo); por defecto el mismo correo de la clínica
  contactName    String? // persona de contacto (registro desde el Portal Vet)
  neighborhood   String? // barrio
  city           String?
  noCharge       Boolean          @default(false) // cliente sin cobro (Pets & Pets): sus resultados nunca se retienen por pago
  // Marca de la clínica en sus reportes (lib/brandColors.ts, components/ClinicLogoPicker.tsx): logo PNG en Blob privado y
  // colores detectados del logo (hex). Sin logo, el reporte sale con el diseño de Pets & Lab.
  logoUrl        String?
  brandPrimary   String?
  brandAccent    String?
  users          User[]
  orders         Order[]
  branches       ClinicBranch[]
  customExams    ExamTemplate[]   @relation("CustomExamClients") // exámenes personalizados para esta clínica
  discounts      ClinicDiscount[]
  creditLine     CreditLine?
  creditPayments CreditPayment[]
  pickups        Pickup[]
  createdAt      DateTime         @default(now())
}

// Sede de una clínica (misma cuenta/NIT, distinta dirección). Cada orden puede ir a una sede.
model ClinicBranch {
  id           String   @id @default(cuid())
  clinicId     String
  clinic       Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name         String // ej. "Principal", "Sede Norte"
  address      String
  neighborhood String?
  city         String?
  phone        String?
  lat          Float? // ubicación en el mapa de clientes (lib/geocode.ts; se puede corregir arrastrando el punto)
  lng          Float?
  geoManual    Boolean  @default(false) // true = ubicada a mano: no se vuelve a calcular sola
  orders       Order[]
  pickups      Pickup[]
  createdAt    DateTime @default(now())
}

model Order {
  id             String        @id @default(cuid())
  orderNumber    String        @unique
  patientName    String
  species        String // Canino | Felino | Otro
  breed          String?
  age            String?
  sex            String? // M | H | ND
  ownerName      String?
  clinicId       String?
  clinic         Clinic?       @relation(fields: [clinicId], references: [id])
  branchId       String?
  branch         ClinicBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  requestingVet  String?
  processedById  String?
  processedBy    User?         @relation("ProcessedBy", fields: [processedById], references: [id])
  status         String        @default("RECIBIDA") // SOLICITADA (desde el portal, aún sin recibir) | RECIBIDA | EN_PROCESO | COMPLETADA
  source         String        @default("LAB") // LAB (registrada por el staff) | PORTAL (solicitada por la clínica)
  // Facturación (/facturacion): la contadora marca la orden como facturada con su número de factura
  invoiceNumber  String?
  invoicedAt     DateTime?
  invoicedByName String?
  // Venta a crédito (/credito, lib/credit.ts): plazo en días (15 | 30) copiado de la línea de crédito al elegir "Crédito";
  // null = de contado. Vence (fecha de la factura o de registro) + creditDays.
  creditDays     Int?
  notes          String?
  // Recogida pedida por la clínica en el Portal Vet (lib/pickups.ts): varias órdenes van en la misma visita
  pickupId       String?
  pickup         Pickup?       @relation(fields: [pickupId], references: [id], onDelete: SetNull)
  exams          OrderExam[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

// Recogida pedida por una clínica desde el Portal Vet (lib/pickups.ts). Garantía: se recoge antes de `deadline`
// (pedido + 1 h 30, solo dentro del horario de garantía; null = sin garantía). Si se recoge tarde, las órdenes de la
// recogida quedan con 50 % de descuento. Una recogida nueva solo 1 h después de la anterior; mientras esté pendiente, las
// solicitudes nuevas de la clínica se suman a ella.
model Pickup {
  id           String        @id @default(cuid())
  clinicId     String
  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  branchId     String?
  branch       ClinicBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  status       String        @default("PENDIENTE") // PENDIENTE | RECOGIDA | NO_LISTA
  deadline     DateTime?
  pickedAt     DateTime?
  pickedByName String?
  late         Boolean       @default(false)
  orders       Order[]
  createdAt    DateTime      @default(now())

  @@index([clinicId, createdAt])
}

model OrderExam {
  id              String              @id @default(cuid())
  orderId         String
  order           Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  templateId      String
  template        ExamTemplate        @relation(fields: [templateId], references: [id])
  status          String              @default("PENDIENTE") // PENDIENTE | COMPLETADO
  price           Float               @default(0)
  discountType    String              @default("VALOR") // VALOR | PORCENTAJE
  discountValue   Float               @default(0)
  paymentTerm     String              @default("CONTADO") // CONTADO | CREDITO
  paymentMethod   String              @default("EFECTIVO") // EFECTIVO | TRANSFERENCIA
  amountPaid      Float               @default(0)
  results         ExamResult[]
  movements       InventoryMovement[]
  uploadedPdfPath String?
  uploadedPdfName String?
  comments        String? // comentarios del encargado; salen al final del examen en el PDF
  photos          ExamPhoto[]
  // Resultado de bloques con formulario propio (hoy el Coprológico: lib/coprologico.ts), en JSON
  structured      Json?
  completedAt     DateTime?
  createdAt       DateTime            @default(now())
}

// Foto adjunta a un examen de una orden (blob privado; se sirve por /api/photos/[photoId])
model ExamPhoto {
  id          String    @id @default(cuid())
  orderExamId String
  orderExam   OrderExam @relation(fields: [orderExamId], references: [id], onDelete: Cascade)
  url         String
  name        String
  role        String? // null = foto de "Comentarios y fotos"; "COPRO_MACRO" = foto de la muestra del Coprológico
  createdAt   DateTime  @default(now())
}

model ExamTemplate {
  id              String               @id @default(cuid())
  name            String
  area            String // Hematología | Bioquímica | Citología | Uroanálisis | Coprología
  turnaround      String // "Mismo día" | "24h" | "48h"
  sampleType      String
  price           Float? // precio de lista; si existe, se precarga en Caja al crear la orden
  description     String? // qué incluye (perfiles) — se muestra al elegir exámenes
  isPromotion     Boolean              @default(false) // examen combinado creado en /promociones (o personalizado)
  isCustom        Boolean              @default(false) // examen personalizado (/personalizados): solo lo ven los clientes de `clients`
  clients         Clinic[]             @relation("CustomExamClients")
  active          Boolean              @default(true) // false = retirado: no se ofrece en órdenes nuevas
  sections        ExamSection[]
  orderExams      OrderExam[]
  recipeItems     RecipeItem[]
  promoComponents PromotionComponent[] @relation("PromoOf") // si es promoción: exámenes que la componen
  inPromotions    PromotionComponent[] @relation("ComponentOf") // promociones que incluyen este examen
}

// Exámenes que componen una promoción (la promoción es a su vez un ExamTemplate con copia de
// sus secciones/campos/receta; esto solo registra de dónde salió)
model PromotionComponent {
  id          String       @id @default(cuid())
  promotionId String
  promotion   ExamTemplate @relation("PromoOf", fields: [promotionId], references: [id], onDelete: Cascade)
  templateId  String
  template    ExamTemplate @relation("ComponentOf", fields: [templateId], references: [id], onDelete: Cascade)
  order       Int          @default(0)

  @@unique([promotionId, templateId])
}

model ExamSection {
  id         String       @id @default(cuid())
  templateId String
  template   ExamTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String
  order      Int          @default(0)
  fields     ExamField[]
}

model ExamField {
  id            String       @id @default(cuid())
  sectionId     String
  section       ExamSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  name          String
  key           String? // id estable del parámetro en el catálogo (ej. "hematocrito"); usado para resolver calcFormula
  unit          String?
  refCanine     String?
  refFeline     String?
  technique     String?
  fieldType     String       @default("number") // number | text | select | calculated
  calcFormula   String? // expresión con los `key` de otros campos de la misma sección, ej. "proteinas_totales - albumina"
  order         Int          @default(0)
  results       ExamResult[]
  // Copia de un parámetro de un examen maestro (en un perfil, promoción o examen derivado): sus
  // rangos se editan en el maestro (/rangos) y se propagan a todas las copias.
  sourceFieldId String?
  sourceField   ExamField?   @relation("FieldCopies", fields: [sourceFieldId], references: [id], onDelete: SetNull)
  copies        ExamField[]  @relation("FieldCopies")
}

model ExamResult {
  id          String    @id @default(cuid())
  orderExamId String
  orderExam   OrderExam @relation(fields: [orderExamId], references: [id], onDelete: Cascade)
  fieldId     String
  field       ExamField @relation(fields: [fieldId], references: [id])
  value       String
  flagged     Boolean   @default(false) // out of reference range
  createdAt   DateTime  @default(now())
}

model InventoryItem {
  id          String              @id @default(cuid())
  name        String
  unit        String // presentación: ML | GR | MG | UNIDAD | CC | KG | ... (texto libre)
  stock       Float               @default(0)
  minStock    Float?
  // Reactivos (ej. tirillas de orina): marca, lote y vencimiento salen en el control de calidad del reporte
  brand       String?
  lot         String?
  expiresAt   DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  recipeItems RecipeItem[]
  movements   InventoryMovement[]
}

// Receta: cantidad de cada insumo que consume un examen al completarse
model RecipeItem {
  id         String        @id @default(cuid())
  templateId String
  template   ExamTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  itemId     String
  item       InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity   Float

  @@unique([templateId, itemId])
}

model InventoryMovement {
  id          String        @id @default(cuid())
  itemId      String
  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity    Float // negativo = salida, positivo = entrada/ajuste
  reason      String // CONSUMO_EXAMEN | AJUSTE
  orderExamId String?
  orderExam   OrderExam?    @relation(fields: [orderExamId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
}

// Configuración del laboratorio editable desde la app (clave -> JSON). Ej. "orina": valores de
// referencia por especie y cortes del UPC del Parcial de Orina (lib/orina.ts).
model LabSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Registro de muestras eliminadas (solo ADMIN, con motivo obligatorio): la orden se borra pero queda
// quién, cuándo, por qué y una copia de sus datos y resultados (snapshot).
model DeletedOrder {
  id            String   @id @default(cuid())
  orderNumber   String
  patientName   String
  species       String
  ownerName     String?
  clinicName    String?
  branchName    String?
  exams         String // nombres de los exámenes
  total         Float    @default(0) // precio neto total
  paid          Float    @default(0)
  status        String // estado de la orden al borrarla
  orderedAt     DateTime // fecha de creación de la orden
  reason        String
  deletedById   String?
  deletedByName String
  deletedAt     DateTime @default(now())
  snapshot      Json // orden completa con exámenes y resultados
}

// Descuento de un cliente (/clientes/[id], permiso "descuentos": ADMIN y COMERCIAL): un % sobre los exámenes de ciertas
// áreas (vacío = todos) para las órdenes registradas entre startDate y endDate (AAAA-MM-DD, hora de Colombia, inclusive).
// Se aplica al crear la orden / agregar o cambiar un examen (lib/discounts.ts) como descuento PORCENTAJE en Caja.
model ClinicDiscount {
  id            String   @id @default(cuid())
  clinicId      String
  clinic        Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  percent       Float
  areas         String[]
  startDate     String
  endDate       String
  note          String?
  createdByName String?
  // Programa de lealtad (lib/loyalty.ts): source = LEALTAD lo crea el sistema solo al cerrar cada corte quincenal
  source        String   @default("MANUAL") // MANUAL | LEALTAD
  loyaltyTier   String? // BRONCE | PLATA | ORO
  loyaltyPeriod String? // corte que lo ganó: AAAA-MM-1 (1-15) | AAAA-MM-2 (16-fin)
  loyaltyCount  Int? // pacientes del corte
  createdAt     DateTime @default(now())

  @@index([clinicId])
}

// Línea de crédito de un cliente (/credito: Michel, Guillermo y Germán — lib/permissions.ts: CREDIT_EMAILS). Cupo en pesos
// (1 a 10 millones) y plazo de 15 o 30 días. Las órdenes a crédito copian el plazo (Order.creditDays). Cartera en /cartera.
model CreditLine {
  id            String   @id @default(cuid())
  clinicId      String   @unique
  clinic        Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  limit         Int
  termDays      Int
  active        Boolean  @default(true)
  createdByName String?
  updatedByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Abono de un cliente a su deuda a crédito (/cartera). Se reparte en las órdenes a crédito más antiguas (sube
// OrderExam.amountPaid); allocations = [{examId, amount}] para poder anularlo.
model CreditPayment {
  id            String   @id @default(cuid())
  clinicId      String
  clinic        Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  amount        Float
  date          String // AAAA-MM-DD (Colombia)
  method        String // EFECTIVO | TRANSFERENCIA
  note          String?
  allocations   Json
  createdByName String?
  createdAt     DateTime @default(now())

  @@index([clinicId])
}
